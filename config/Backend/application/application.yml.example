# Example Spring configuration for the DSP backend (adopter overrides).
# Datasource and installation-config are injected by docker-compose from .env.

server:
  port: 8080
  servlet:
    context-path: /dsp-backend

spring:
  datasource:
    url: jdbc:postgresql://dsp-db:5432/dsp-db
    username: dsp
    password: dsp
  jpa:
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        default_schema: dsp

dsp:
  installation-config:
    file: file:/config/installation-config.json
