# Generic application.yaml template — edit application.yaml with your adopter source and ETL mapping.
# Guide: docs/migration-config.md

spring:
  application:
    name: dsp-batch
  main:
    web-application-type: none
  datasource:
    batch:
      url: jdbc:postgresql://dsp-job-migration-db:5432/dsp-job-migration-db
      username: dsp_job
      password: dsp_job
      driver-class-name: org.postgresql.Driver
      hikari:
        maximum-pool-size: 10
        minimum-idle: 2
        pool-name: batch-pool
        connection-test-query: SELECT 1
    source:
      # Adopter source database (values from .env / Compose).
      url: ${DSP_SOURCE_JDBC_URL}
      username: ${DSP_SOURCE_DB_USER}
      password: ${DSP_SOURCE_DB_PASSWORD}
      driver-class-name: org.postgresql.Driver
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: source-pool
    target:
      url: jdbc:postgresql://dsp-db:5432/dsp-db
      username: dsp
      password: dsp
      driver-class-name: org.postgresql.Driver
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: target-pool
    geo-target:
      url: jdbc:postgresql://dsp-geoserver-exhibition-db:5432/dsp-geoserver-exhibition-db
      username: dsp_geo
      password: dsp_geo
      driver-class-name: org.postgresql.Driver
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
        pool-name: geo-target-pool
  batch:
    job:
      enabled: false
    jdbc:
      initialize-schema: never

server:
  port: 8086

batch:
  admin-unit:
    # Adopter territorial hierarchy: L1 → L2 → L3 (parent_id links to the parent level).
    level-1:
      # Source table or SQL subquery. Replace the placeholders.
      source-table: <source_schema>.<source_table>
      target-table: dsp.territory_level_1
      primary-key: <source_pk>
      geometry-column: <source_geom>
      where-clause: "1=1"
      comparison-columns:
        - <source_name>
      persist-columns:
        - <source_pk>
        - <source_name>
      column-mapping:
        <source_pk>: id
        <source_name>: name
        <source_geom>: geom
      layer-name: territory-level-1
      srid: ${LAYER_SRS_TERRITORY_LEVEL_1:4326}
      change-detection-strategy: DEFAULT
    level-2:
      source-table: <source_schema>.<source_table>
      target-table: dsp.territory_level_2
      primary-key: <source_pk>
      # Column used to partition the job in parallel (usually the parent).
      partition-column: <source_parent_pk>
      geometry-column: <source_geom>
      where-clause: "1=1"
      comparison-columns:
        - <source_name>
        - <source_parent_pk>
      persist-columns:
        - <source_pk>
        - <source_name>
        - <source_parent_pk>
      column-mapping:
        <source_pk>: id
        <source_name>: name
        <source_parent_pk>: parent_id
        <source_geom>: geom
      layer-name: territory-level-2
      srid: ${LAYER_SRS_TERRITORY_LEVEL_2:4326}
      change-detection-strategy: DEFAULT
    level-3:
      source-table: <source_schema>.<source_table>
      target-table: dsp.territory_level_3
      primary-key: <source_pk>
      partition-column: <source_parent_pk>
      geometry-column: <source_geom>
      where-clause: "1=1"
      comparison-columns:
        - <source_name>
        - <source_parent_pk>
      persist-columns:
        - <source_pk>
        - <source_name>
        - <source_parent_pk>
      column-mapping:
        <source_pk>: id
        <source_name>: name
        <source_parent_pk>: parent_id
        <source_geom>: geom
      layer-name: territory-level-3
      srid: ${LAYER_SRS_TERRITORY_LEVEL_3:4326}
      change-detection-strategy: DEFAULT
  area-of-interest:
    # Entities of interest linked to territory_level_3 (FK).
    # Optional: subquery that computes measures → theme_1..theme_4 (dsp-db only).
    source-table: <source_schema>.<source_table>
    target-table: dsp.area_of_interest
    primary-key: <source_pk>
    geometry-column: <source_geom>
    where-clause: "1=1"
    # Columns compared for change detection (exhibition-db). Do not list themes here.
    comparison-columns:
      - <source_updated_at>
      - <source_territory_level_3_fk>
      - <source_area>
    persist-columns:
      - <source_pk>
      - <source_created_at>
      - <source_updated_at>
      - <source_territory_level_3_fk>
      - <source_area>
    # Written only to dsp-db (not exhibition-db). Remove if you have no theme KPIs.
    business-only-persist-columns:
      - <source_theme_1>
      - <source_theme_2>
      - <source_theme_3>
      - <source_theme_4>
    column-mapping:
      <source_pk>: id
      <source_created_at>: registration_date
      <source_updated_at>: alteration_date
      <source_territory_level_3_fk>: territory_level_3_id
      <source_area>: area
      <source_geom>: geom
      <source_theme_1>: theme_1
      <source_theme_2>: theme_2
      <source_theme_3>: theme_3
      <source_theme_4>: theme_4
    layer-name: area-of-interest
    srid: ${LAYER_SRS_AREA_OF_INTEREST:4326}
    change-detection-strategy: DEFAULT
  # Generic layers: job creates dsp.<table> on geo-target automatically.
  # The AOI link column becomes area_of_interest_id on the target.
  # Generated from adopter-config etl.layers by ./config.sh.
  # Example (commented — filled by ./config.sh):
  # layers:
  #   - source-table: conservation.mixed_geometries
  #     area-of-interest-id-column: conservation_unit_id
  #     primary-key: feature_id
  #     geometry-column: boundary
  #     layer-name: mixed_geometries
  #     srid: 4674
  #     where-clause: "1=1"
  #     enabled: true
  layers: []

parallelization:
  jobs:
    adminUnitLevel1GeoserverJob:
      enabled: true
      thread-pool-size: 1
      chunk-size: 1
      page-size: 1000
      queue-capacity: 100
    adminUnitLevel2GeoserverJob:
      enabled: true
      thread-pool-size: 12
      chunk-size: 1
      page-size: 1000
      queue-capacity: 100
    adminUnitLevel3GeoserverJob:
      enabled: true
      thread-pool-size: 12
      chunk-size: 470
      page-size: 1000
      queue-capacity: 100
    areaOfInterestGeoserverJob:
      enabled: true
      thread-pool-size: 1
      chunk-size: 100
      page-size: 1000
      queue-capacity: 100

execution-jobs:
  admin-unit-level-1-geoserver-job: true
  admin-unit-level-2-geoserver-job: true
  admin-unit-level-3-geoserver-job: true
  area-of-interest-geoserver-job: true
  layer-jobs: false

logging:
  level:
    br.car.dsp_batch: INFO
    br.car.dsp_batch.batch.strategy: INFO
