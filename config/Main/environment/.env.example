# Mirror of the root .env.example for adopters who prefer the RER-style path
# config/Main/environment/.env
#
# Prefer copying the repository root .env.example:
#   cp .env.example .env

DSP_HTTP_HOST=localhost
DSP_BACKEND_HOST_PORT=8080
DSP_FRONTEND_HOST_PORT=8081

DSP_DB_HOST_PORT=5433
DSP_DB_NAME=dsp-db
DSP_DB_USER=dsp
DSP_DB_PASSWORD=dsp

DSP_JOB_MIGRATION_DB_HOST_PORT=5434
DSP_JOB_MIGRATION_DB_NAME=dsp-job-migration-db
DSP_JOB_MIGRATION_DB_USER=dsp_job
DSP_JOB_MIGRATION_DB_PASSWORD=dsp_job

DSP_SOURCE_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/source_db
DSP_SOURCE_DB_USER=source_user
DSP_SOURCE_DB_PASSWORD=source_user

DSP_RUN_MIGRATION=false
DSP_INSTALLATION_CONFIG_FILE=file:/config/installation-config.json

DSP_BACKEND_CONTEXT_PATH=/dsp-backend
DSP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost/dsp,http://localhost:5173,http://localhost:8081
DSP_BACKEND_PATH=../rer-dsp-backend
DSP_FRONTEND_PATH=../rer-dsp-frontend
DSP_JOB_MIGRATION_PATH=../rer-dsp-job-data-migration
VITE_BASE_URL=/dsp/
VITE_DSP_API_URL=http://localhost:8080/dsp-backend
APP_VERSION=0.0.0
