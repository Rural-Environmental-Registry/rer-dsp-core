# Template for .env — created automatically by ./config.sh, ./setup.sh or ./start.sh
# when .env does not exist yet. Edit this file only to change the defaults for new installs.

# --- Host / ports -------------------------------------------------------------
DSP_HTTP_HOST=localhost
DSP_BACKEND_HOST_PORT=22666
DSP_FRONTEND_HOST_PORT=22667

# --- Databases ----------------------------------------------------------------
DSP_DB_HOST_PORT=20654
DSP_DB_NAME=dsp-db
DSP_DB_USER=dsp
DSP_DB_PASSWORD=dsp

DSP_GEOSERVER_DB_HOST_PORT=20656
DSP_GEOSERVER_DB_NAME=dsp-geoserver-db
DSP_GEOSERVER_DB_USER=dsp_geo
DSP_GEOSERVER_DB_PASSWORD=dsp_geo

DSP_JOB_MIGRATION_DB_HOST_PORT=20655
DSP_JOB_MIGRATION_DB_NAME=dsp-job-migration-db
DSP_JOB_MIGRATION_DB_USER=dsp_job
DSP_JOB_MIGRATION_DB_PASSWORD=dsp_job

# Source DB for ./setup.sh (Compose DSP_SOURCE_* overrides YAML source)
# Local test:
# DSP_SOURCE_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/source_db
# DSP_SOURCE_DB_USER=source_user
# DSP_SOURCE_DB_PASSWORD=source_user
DSP_SOURCE_JDBC_URL=jdbc:postgresql://source-db-host:5433/car_nacional
DSP_SOURCE_DB_USER=postgres
DSP_SOURCE_DB_PASSWORD=postgres

# ETL mapping: config/Job-Data-Migration/application/application.yaml
# Migration on/off is chosen interactively in ./setup.sh (options 2 vs 3).
# once       — one-time migration during setup; job not kept in ./start.sh stack
# continuous — migration stack stays up for external scheduling (set by ./setup.sh)
DSP_MIGRATION_EXECUTION_MODE=once

# --- Backend ------------------------------------------------------------------
DSP_BACKEND_CONTEXT_PATH=/dsp-backend
DSP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost/dsp,http://localhost:5173,http://localhost:22667
DSP_INSTALLATION_CONFIG_FILE=file:/config/installation-config.json
DSP_MAP_LAYERS_FILE=file:/config/mapLayersConfig.json
DSP_DOWNLOAD_THEMES_FILE=file:/config/downloadThemesConfig.json
# Backend (container) → GeoServer Download on the Docker network. Do not use localhost here with Docker Compose.
DSP_GEOSERVER_WFS_BASE_URL=http://dsp-geoserver-download:8080/geoserver/dsp/wfs

# --- GeoServer Exhibition (map WMS/WFS) ----------------------------------------
DSP_GEOSERVER_HOST_PORT=22668
DSP_GEOSERVER_ADMIN_USER=admin
DSP_GEOSERVER_ADMIN_PASSWORD=geoserver

# --- GeoServer Download (WFS for /downloads) -----------------------------------
DSP_GEOSERVER_DOWNLOAD_HOST_PORT=22669

DSP_BACKEND_PATH=../rer-dsp-backend
DSP_FRONTEND_PATH=../rer-dsp-frontend
DSP_JOB_MIGRATION_PATH=../rer-dsp-job-data-migration

# --- Frontend -----------------------------------------------------------------
VITE_BASE_URL=/dsp/
VITE_DSP_API_URL=http://localhost:22666/dsp-backend
APP_VERSION=0.0.0

# GeoServer Layer SRS (Coordinate Reference System)
LAYER_SRS_TERRITORY_LEVEL_1=4674
LAYER_SRS_TERRITORY_LEVEL_2=4674
LAYER_SRS_TERRITORY_LEVEL_3=4674
LAYER_SRS_AREA_OF_INTEREST=4674