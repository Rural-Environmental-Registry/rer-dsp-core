# =============================================================================
# RER DSP — Core (installation environment)
# Copy to .env before running ./start.sh
# =============================================================================

# --- Host / ports -------------------------------------------------------------
DSP_HTTP_HOST=localhost
DSP_BACKEND_HOST_PORT=8080
DSP_FRONTEND_HOST_PORT=8081

# --- Backend ------------------------------------------------------------------
DSP_BACKEND_CONTEXT_PATH=/dsp-backend
DSP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost/dsp,http://localhost:5173,http://localhost:8081

# Paths relative to this core repository
DSP_BACKEND_PATH=../rer-dsp-backend
DSP_FRONTEND_PATH=../rer-dsp-frontend

# --- Frontend -----------------------------------------------------------------
# Base path of the SPA (must match nginx in the frontend image)
VITE_BASE_URL=/dsp/

# API URL used at build time (baked into the frontend image).
# Without a reverse proxy, point to the published backend port on the host:
VITE_DSP_API_URL=http://localhost:8080/dsp-backend
# With a future proxy in front of both services, you can use a relative path:
# VITE_DSP_API_URL=/dsp-backend

APP_VERSION=0.0.0
